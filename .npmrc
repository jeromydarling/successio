# wrangler@4 optionally peers on @cloudflare/workers-types v5 while this
# project (and @cloudflare/vitest-pool-workers' bundled wrangler 3) pin v4.
# The combination works — workers-types is types-only — but strict npm ci
# rejects it. This makes CI resolve the same way the lockfile was generated.
legacy-peer-deps=true
