# ----------------------------------------------------------------------------
# Successio — local development secrets template
# Copy to `.dev.vars` (gitignored) and fill in. In production, set these as
# encrypted secrets via `wrangler secret put <NAME>` or the Cloudflare dashboard.
#
# The canonical registry of every key lives at the END of CLAUDE.md.
# ----------------------------------------------------------------------------

# AI providers (routed through Cloudflare AI Gateway — never called directly)
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GOOGLE_AI_API_KEY=

# Cloudflare
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=successio-prod

# App secrets
JWT_SECRET=
ENCRYPTION_KEY=
# Password for the /superadmin CRM (32+ chars). Prod: GitHub repo secret,
# synced to the Worker on every deploy.
SUPER_ADMIN_TOKEN=
# Gates the E2E seed/purge endpoints. Unset = endpoints disabled (fail closed).
E2E_ADMIN_TOKEN=

# NOTE: R2 S3-API credentials were removed — uploads/downloads go through the
# R2 binding (POST /api/upload), so no presigned-URL keys are needed.

# Sentry error monitoring.
# - SENTRY_DSN: server/edge/worker runtime DSN. In production this is a CF
#   Worker secret (already set via dashboard); set it here for local runs.
# - NEXT_PUBLIC_SENTRY_DSN: client DSN. Next bakes NEXT_PUBLIC_* into the
#   browser bundle at BUILD time, so it must also be set as a Plaintext build
#   variable in CF Workers Builds (not just a runtime secret).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
