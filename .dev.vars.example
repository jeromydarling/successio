# ----------------------------------------------------------------------------
# Successio — local development secrets template
# Copy to `.dev.vars` (gitignored) and fill in. In production, set these as
# encrypted secrets via `wrangler secret put <NAME>` or the Cloudflare dashboard.
#
# The canonical registry of every key lives at the END of CLAUDE.md.
# ----------------------------------------------------------------------------

# AI providers (routed through Cloudflare AI Gateway — never called directly)
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GOOGLE_AI_API_KEY=

# Cloudflare
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=successio-prod

# App secrets
JWT_SECRET=
ENCRYPTION_KEY=

# R2 S3-API credentials (Cloudflare dashboard → R2 → Manage API tokens)
# Used to generate presigned upload/download URLs for direct browser ↔ R2 transfer.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=successio-documents
